# Zkopírujte do .env.local a doplňte hodnoty. Soubor .env.local nikdy necommitujte.

# Veřejná URL webu (pro sitemap, OG, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.example.cz

# Kontaktní formulář – Resend
RESEND_API_KEY=
# Ověřená odesílací adresa v Resend, např. "AI Akademie <web@example.cz>"
CONTACT_FROM_EMAIL=
# Kam chodí poptávky
CONTACT_TO_EMAIL=
