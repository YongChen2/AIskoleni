# Zkopírujte do .env.local a doplňte hodnoty. Soubor .env.local nikdy necommitujte.

# Veřejná URL webu (pro sitemap, OG, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.example.cz

# Živé AI demo – Anthropic API
ANTHROPIC_API_KEY=
# Volitelně jiný model (výchozí viz src/app/api/demo/route.ts)
ANTHROPIC_MODEL=

# Rate limit AI dema – Upstash Redis (Vercel Marketplace). Bez nich se použije limit v paměti instance.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Kontaktní formulář – Resend
RESEND_API_KEY=
# Ověřená odesílací adresa v Resend, např. "AI Akademie <web@example.cz>"
CONTACT_FROM_EMAIL=
# Kam chodí poptávky
CONTACT_TO_EMAIL=
